<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp"
    android:weightSum="3"
    tools:context=".activities.ShoppingActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/priceTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/text_color"
                android:textSize="20dp" />

            <ImageView
                android:id="@+id/previewIV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@drawable/cursor" />

            <TextView
                android:id="@+id/confirmTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_button_background"
                android:text="Confirm"
                android:textAlignment="center"
                android:textColor="@color/text_color"
                android:textSize="30dp" />

            <TextView
                android:id="@+id/equipThis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_button_background"
                android:text="Equip"
                android:visibility="gone"
                android:textAlignment="center"
                android:textColor="@color/text_color"
                android:textSize="30dp" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/machine1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/cursor" />

                <TextView
                    android:id="@+id/machine1PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/machine2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/machine_5" />

                <TextView
                    android:id="@+id/machine2PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />




            </LinearLayout>

            <LinearLayout
                android:id="@+id/machine3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/machine_2" />

                <TextView
                    android:id="@+id/machine3PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />




            </LinearLayout>

            <LinearLayout
                android:id="@+id/machine4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/machine_3" />

                <TextView
                    android:id="@+id/machine4PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="30000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />



            </LinearLayout>

            <LinearLayout
                android:id="@+id/machine5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/machine_4" />

                <TextView
                    android:id="@+id/machine5PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="40000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />


            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/color1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/bottle_pink" />

                <TextView
                    android:id="@+id/color1PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/color2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/bottle_red" />

                <TextView
                    android:id="@+id/color2PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="10000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/color3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/bottle_pink" />

                <TextView
                    android:id="@+id/color3PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/color4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/bottle_red" />

                <TextView
                    android:id="@+id/color4PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="30000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/color5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="40dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="centerInside"
                    android:src="@drawable/bottle_pink" />

                <TextView
                    android:id="@+id/color5PriceTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="40000 P"
                    android:textAlignment="center"
                    android:textColor="@color/text_color"
                    android:textSize="20dp" />


            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</LinearLayout>