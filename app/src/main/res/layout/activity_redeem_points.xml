<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background"
    tools:context=".RedeemPointsActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/storeNameTVRedeemActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-smallcaps"
            android:text="NabDroid"
            android:textColor="@color/white"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/authoreNameTVRedeemActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-smallcaps"
            android:text="Emanuele"
            android:textColor="@color/white"
            android:textSize="16dp" />



        <TextView
            android:id="@+id/locationTVRedeemActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-smallcaps"
            android:text="location"
            android:textColor="@color/white"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/storeEmailTVRedeemActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-smallcaps"
            android:text="nabdroid313@gmail.com"
            android:textColor="@color/white"
            android:textSize="16dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_marginTop="30dp"
        android:layout_marginRight="10dp"
        android:gravity="right"
        android:orientation="vertical">

        <TextView
            android:id="@+id/userNameTVRedeemActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-smallcaps"
            android:text="Kazi Zuljalal"
            android:textColor="@color/white"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/totalPointsTVRedeemActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-smallcaps"
            android:text="Available: 1409"
            android:textColor="@color/white"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/redeemInstructionTVRedeemActivity"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-smallcaps"
            android:text="Redeem 10000 points to get 10% discount!"
            android:textColor="@color/white"
            android:textSize="16dp" />


        <Button
            android:id="@+id/redeemButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Redeem"
            android:fontFamily="sans-serif-smallcaps"
            android:textSize="16dp"
            android:textAllCaps="false"
            android:textColor="@color/text_color"/>


    </LinearLayout>


</RelativeLayout>